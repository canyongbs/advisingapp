{
    "name": "advising-app",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:application && npm run build:form && npm run build:survey && npm run build:customer-advisor && npm run build:event-registration && npm run build:booking-page",
        "build:application": "(cd application && vite build)",
        "build:event-registration": "(cd event-registration && vite build)",
        "build:form": "(cd form && vite build)",
        "build:survey": "(cd survey && vite build)",
        "build:customer-advisor": "(cd customer-advisor && vite build)",
        "build:booking-page": "(cd booking-page && vite build)",
        "dev": "npm run dev:application & npm run dev:form & npm run dev:survey & npm run dev:customer-advisor & npm run dev:event-registration & npm run dev:booking-page & wait",
        "dev:application": "(cd application && vite build --watch)",
        "dev:event-registration": "(cd event-registration && vite build --watch)",
        "dev:form": "(cd form && vite build --watch)",
        "dev:survey": "(cd survey && vite build --watch)",
        "dev:customer-advisor": "(cd customer-advisor && vite build --watch)",
        "dev:booking-page": "(cd booking-page && vite build --watch)",
        "postinstall": "node ../npm-postinstall.cjs"
    },
    "dependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.20",
