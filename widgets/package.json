        "filepond": "^4.32.8",
        "filepond-plugin-file-validate-size": "^2.2.8",
        "filepond-plugin-file-validate-type": "^1.2.9",
        "filepond-plugin-image-preview": "^4.6.12",
        "flowbite": "^2.3.0",
        "laravel-echo": "^1.14.0",
        "laravel-vite-plugin": "^3.2.0",
        "pinia": "^3.0.4",
        "resolve-url-loader": "^5.0.0",
        "tailwindcss": "^4.3.3",
        "tippy.js": "^6.3.7",
        "vite": "^8.2.2",
        "vue-filepond": "^7.0.4"
    },
    "devDependencies": {
        "@formkit/icons": "^1.2.2",
